{
  "id": "acme-client",
  "cast": {
    "ACME": "Jordan Lee (Acme Corp)",
    "CEO": "you"
  },
  "node_depends_on": [ { "node": "hr-policy", "type": "static" } ],
  "emails": [
    {
      "id": "acme-client.request",
      "from": "ACME",
      "to": "CEO",
      "subject": "Can we meet?",
      "body": "Hi! Could we grab time on {next:THU} at 2 PM to walk through the renewal? Thanks.",
      "depends_on": [],
      "answer": {
        "expect": [
          {
            "action": "create_event",
            "title_match": ["acme"],
            "start": { "eq": "next:THU" },
            "count": 1
          }
        ]
      }
    },
    {
      "id": "acme-client.move",
      "from": "ACME",
      "to": "CEO",
      "subject": "Re: Can we meet?",
      "body": "Actually, something came up — can we move our renewal call to {next:MON} instead?",
      "depends_on": [ { "email": "acme-client.request", "type": "static" } ],
      "answer": {
        "expect": [
          {
            "action": "create_event",
            "title_match": ["acme"],
            "start": { "eq": "next:MON" },
            "count": 1
          }
        ]
      }
    }
  ]
}
