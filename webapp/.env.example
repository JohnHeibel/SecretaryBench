# Neon Postgres. The Neon native Vercel integration sets DATABASE_URL; the older
# Vercel Postgres product sets POSTGRES_URL. store.ts accepts either. For local dev,
# copy to .env.local and fill from your Neon dashboard (omit to use the .data/ file
# backend). Set APP_PASSCODE in Vercel for Production AND Preview.
POSTGRES_URL="postgres://user:pass@host/db?sslmode=require"

# Single shared passcode gating the whole app (>=20 trusted users).
# Set the same value in Vercel project env vars (all environments).
APP_PASSCODE="change-me"

# Base URL the Next client uses to reach the Python validation functions. Leave blank
# in prod and for `vercel dev` (same origin). NOTE: NEXT_PUBLIC_* is inlined at build
# time, so do NOT set this in Vercel prod env or it bakes into the client bundle.
NEXT_PUBLIC_VALIDATOR_BASE=""
